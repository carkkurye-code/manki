# =====================================================================
# MEXC SMART WALLET TRACKER (V1) - ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. MEXC API (Read-Only / Market Data)
# Note: Public market data can be queried without keys, but you can supply
# read-only API credentials to increase rate limits. Never provide trading/withdrawal permissions!
MEXC_API_KEY=
MEXC_API_SECRET=

# 2. Telegram Bot Configuration (For Live Pre-Listing & Multi-Wallet Alerts)
# TELEGRAM_BOT_TOKEN: Obtained from @BotFather on Telegram (e.g., 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
# TELEGRAM_CHAT_ID: Target user or channel ID (e.g., -1001234567890 or 987654321)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3. On-Chain DEX Historical Trade Provider (Bitquery v2)
# BITQUERY_API_KEY: Personal access token or OAuth token obtained from https://account.bitquery.io/
# Used for querying pre-listing DEX BUY transactions across EVM (Ethereum, BSC, Base) and Solana
BITQUERY_API_KEY=
